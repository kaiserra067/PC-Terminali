<UserControl x:Class="TemizlikPaneli.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,32">
            <!-- Başlık -->
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="RescanButton" Click="Rescan_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0" />
                        <TextBlock Text="Yeniden tara" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Genel bakış" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Bilgisayarınızda neyin ne kadar yer kapladığı ve nelerin güvenle temizlenebileceği." Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </DockPanel>

            <!-- Sürücüler -->
            <ItemsControl x:Name="DrivesList" Margin="0,22,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="24,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,40,0" MinWidth="190">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding FreeText}" Style="{StaticResource Hero}" Margin="0,2,0,0" />
                                    <TextBlock Text="boş alan" Style="{StaticResource Label}" Margin="0,-4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{Binding StatusSoft}"
                                                Visibility="{Binding StatusText, Converter={StaticResource Vis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Foreground="{Binding StatusBrush}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding UsedText}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="12" Margin="0,12,0,0" Foreground="{Binding MeterBrush}" />
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Label}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Özet kutuları -->
            <UniformGrid Columns="4" Margin="-6,0,-6,0">
                <Button Style="{StaticResource TileButton}" Tag="junk" Click="Tile_Click">
                    <StackPanel>
                        <TextBlock Text="Temizlenebilir gereksiz dosyalar" Style="{StaticResource Label}" />
                        <TextBlock x:Name="JunkValue" Text="…" Style="{StaticResource StatValue}" Margin="0,6,0,0" />
                        <TextBlock x:Name="JunkSub" Text="Taranıyor" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Tag="leftovers" Click="Tile_Click">
                    <StackPanel>
                        <TextBlock Text="Kalıntılar" Style="{StaticResource Label}" />
                        <TextBlock x:Name="LeftValue" Text="…" Style="{StaticResource StatValue}" Margin="0,6,0,0" />
                        <TextBlock x:Name="LeftSub" Text="Taranıyor" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Tag="games" Click="Tile_Click">
                    <StackPanel>
                        <TextBlock Text="Oyunlar" Style="{StaticResource Label}" />
                        <TextBlock x:Name="GamesValue" Text="…" Style="{StaticResource StatValue}" Margin="0,6,0,0" />
                        <TextBlock x:Name="GamesSub" Text="Taranıyor" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Tag="apps" Click="Tile_Click">
                    <StackPanel>
                        <TextBlock Text="Uygulamalar" Style="{StaticResource Label}" />
                        <TextBlock x:Name="AppsValue" Text="…" Style="{StaticResource StatValue}" Margin="0,6,0,0" />
                        <TextBlock x:Name="AppsSub" Text="Taranıyor" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Klasörler ve dosya türleri -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Disk analizine git" Tag="analyzer" Click="Tile_Click" />
                            <TextBlock x:Name="FoldersTitle" Text="En çok yer kaplayan klasörler" Style="{StaticResource SectionTitle}" />
                        </DockPanel>
                        <TextBlock x:Name="ScanNote" Style="{StaticResource Label}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Height="4" Margin="0,10,0,0" />
                        <ItemsControl x:Name="FolderBars" ItemTemplate="{StaticResource BarRowTemplate}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Dosya türlerine göre" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="KindNote" Text="Sürücü taraması bitince gösterilir." Style="{StaticResource Label}" Margin="0,4,0,0" />
                        <ItemsControl x:Name="KindBars" ItemTemplate="{StaticResource BarRowTemplate}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Oyunlar ve uygulamalar -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Tüm oyunlar" Tag="games" Click="Tile_Click" />
                            <TextBlock Text="En büyük oyunlar" Style="{StaticResource SectionTitle}" />
                        </DockPanel>
                        <ItemsControl x:Name="GameBars" ItemTemplate="{StaticResource BarRowTemplate}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Tüm uygulamalar" Tag="apps" Click="Tile_Click" />
                            <TextBlock Text="En büyük uygulamalar" Style="{StaticResource SectionTitle}" />
                        </DockPanel>
                        <ItemsControl x:Name="AppBars" ItemTemplate="{StaticResource BarRowTemplate}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
