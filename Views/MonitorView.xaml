<UserControl x:Class="TemizlikPaneli.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TemizlikPaneli.Controls">
    <UserControl.Resources>
        <Style x:Key="BigValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Margin" Value="0,14,0,12" />
        </Style>
        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,32">
            <TextBlock Text="Donanım izleyici" Style="{StaticResource PageTitle}" />
            <TextBlock Text="İşlemci, ekran kartı ve belleğin anlık değerleri ve üzerlerinde yapılmış ayarlar (PBO, undervolt, güç limiti, bellek zamanlamaları). Saniyede bir güncellenir."
                       Style="{StaticResource PageSubtitle}" />

            <!-- Sensör durumu -->
            <Border x:Name="SensorBar" Margin="0,16,0,0" Padding="16,10" CornerRadius="8" Background="{DynamicResource Surface2Bg}">
                <DockPanel>
                    <Button x:Name="SensorButton" DockPanel.Dock="Right" VerticalAlignment="Center" Click="SensorButton_Click" />
                    <TextBlock x:Name="SensorIcon" Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0" />
                    <TextBlock x:Name="SensorText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0" />
                </DockPanel>
            </Border>

            <!-- Özet şeridi: ad, kullanım ve sıcaklık -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,14">
                <UniformGrid Columns="3">
                    <DockPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE950;" FontSize="18" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock x:Name="SumCpuName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SumCpu" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="18" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock x:Name="SumGpuName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SumGpu" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE964;" FontSize="18" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock x:Name="SumRamName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SumRam" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </UniformGrid>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===================== İşlemci ===================== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="İşlemci" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Columns="3" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Kullanım" Style="{StaticResource Label}" />
                                <TextBlock x:Name="CpuUsage" Text="—" Style="{StaticResource BigValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Sıcaklık (°C)" Style="{StaticResource Label}" />
                                <TextBlock x:Name="CpuTemp" Text="—" Style="{StaticResource BigValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Saat hızı (GHz)" Style="{StaticResource Label}" />
                                <TextBlock x:Name="CpuClock" Text="—" Style="{StaticResource BigValue}" />
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock x:Name="CpuTempIcon" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock x:Name="CpuTempState" Style="{StaticResource Label}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="Kullanım · son 60 saniye" Style="{StaticResource Label}" Margin="0,16,0,6" />
                        <c:Sparkline x:Name="CpuSpark" Height="56" />
                        <TextBlock Text="Çekirdek başına kullanım" Style="{StaticResource Label}" Margin="0,14,0,6" />
                        <ItemsControl x:Name="CoreBars" Height="44">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="1,0" Background="Transparent" ToolTip="{Binding Tip}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{Binding Fraction, Converter={StaticResource InvStar}}" />
                                            <RowDefinition Height="{Binding Fraction, Converter={StaticResource Star}}" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="1" Background="{DynamicResource Series1}" CornerRadius="3,3,0,0" MinHeight="2" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource Divider}" />
                        <StackPanel x:Name="CpuRows" />
                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Text="Ayarlar (tuning)" Style="{StaticResource SubTitle}" />
                        <StackPanel x:Name="CpuTuneRows" />
                    </StackPanel>
                </Border>

                <!-- ===================== Ekran kartı ===================== -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Ekran kartı" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Columns="3" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Kullanım" Style="{StaticResource Label}" />
                                <TextBlock x:Name="GpuUsage" Text="—" Style="{StaticResource BigValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Sıcaklık (°C)" Style="{StaticResource Label}" />
                                <TextBlock x:Name="GpuTemp" Text="—" Style="{StaticResource BigValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Çekirdek (MHz)" Style="{StaticResource Label}" />
                                <TextBlock x:Name="GpuClock" Text="—" Style="{StaticResource BigValue}" />
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock x:Name="GpuTempIcon" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock x:Name="GpuTempState" Style="{StaticResource Label}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="Kullanım · son 60 saniye" Style="{StaticResource Label}" Margin="0,16,0,6" />
                        <c:Sparkline x:Name="GpuSpark" Height="56" />
                        <DockPanel Margin="0,14,0,0">
                            <TextBlock x:Name="VramText" DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="Ekran belleği (VRAM)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <ProgressBar x:Name="VramBar" Maximum="100" Margin="0,8,0,0" />
                        <Border Style="{StaticResource Divider}" />
                        <StackPanel x:Name="GpuRows" />
                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Text="Ayarlar (tuning)" Style="{StaticResource SubTitle}" />
                        <StackPanel x:Name="GpuTuneRows" />
                    </StackPanel>
                </Border>

                <!-- ===================== Bellek ===================== -->
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Bellek (RAM)" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Columns="3" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Kullanım" Style="{StaticResource Label}" />
                                <TextBlock x:Name="RamUsage" Text="—" Style="{StaticResource BigValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Kullanılan (GB)" Style="{StaticResource Label}" />
                                <TextBlock x:Name="RamUsedBig" Text="—" Style="{StaticResource BigValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Saat (MHz)" Style="{StaticResource Label}" />
                                <TextBlock x:Name="RamClock" Text="—" Style="{StaticResource BigValue}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Kullanım · son 60 saniye" Style="{StaticResource Label}" Margin="0,16,0,6" />
                        <c:Sparkline x:Name="RamSpark" Height="56" />
                        <DockPanel Margin="0,14,0,0">
                            <TextBlock x:Name="RamUsedText" DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="Kullanılan / toplam" Style="{StaticResource Label}" />
                        </DockPanel>
                        <ProgressBar x:Name="RamBar" Maximum="100" Margin="0,8,0,0" />
                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Text="Modül ve çip bilgisi" Style="{StaticResource SubTitle}" />
                        <StackPanel x:Name="RamRows" />
                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Text="Zamanlamalar (şu an çalışan)" Style="{StaticResource SubTitle}" />
                        <StackPanel x:Name="RamTuneRows" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Style="{StaticResource Label}" Margin="2,14,0,0" TextWrapping="Wrap"
                       Text="Ekran kartı değerleri ve ayarları Windows'tan ve AMD sürücüsünden okunur. İşlemci sıcaklığı, PBO sınırları, bellek çipi ve zamanlamalar LibreHardwareMonitor ve imzalı PawnIO sürücüsüyle, yalnızca yönetici modunda okunur. Hiçbir ayar değiştirilmez; bu sayfa yalnızca okur." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
