<UserControl x:Class="TemizlikPaneli.Views.JunkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,32">
            <TextBlock Text="Gereksiz dosyalar" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Önbellekler, geçici dosyalar, hata raporları ve kurulum artıkları. Çerezler, şifreler, tarayıcı geçmişi ve kişisel dosyalarınıza dokunulmaz."
                       Style="{StaticResource PageSubtitle}" />

            <!-- Yönetici uyarısı -->
            <Border x:Name="AdminNotice" Margin="0,18,0,0" Padding="16,12" CornerRadius="8" Background="{DynamicResource WarningSoftBrush}" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Yönetici olarak yeniden başlat" Click="Elevate_Click" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource WarningBrush}" Margin="0,0,10,0" />
                    <TextBlock x:Name="AdminNoticeText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                </DockPanel>
            </Border>

            <!-- Özet -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Seçili temizlik" Style="{StaticResource Label}" />
                        <TextBlock x:Name="SelectedText" Text="…" Style="{StaticResource Hero}" />
                        <TextBlock x:Name="SelectedSub" Style="{StaticResource Secondary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ScanButton" Click="Scan_Click" Padding="16,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0" />
                                <TextBlock Text="Yeniden tara" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CleanButton" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Padding="22,9" Click="Clean_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,8,0" />
                                <TextBlock Text="Seçilenleri temizle" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <ProgressBar x:Name="Progress" Height="6" />
                        <TextBlock x:Name="ProgressText" Style="{StaticResource Label}" Margin="0,6,0,0" />
                    </StackPanel>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                </Grid>
            </Border>

            <!-- Kategoriler -->
            <ItemsControl x:Name="Groups" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="10,12,10,8">
                            <StackPanel>
                                <DockPanel Margin="10,0,12,6">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" Style="{StaticResource Num}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                    <CheckBox IsChecked="{Binding AllSelected, Mode=TwoWay}" IsThreeState="False" Click="GroupCheck_Click">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                    </CheckBox>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="row" CornerRadius="6" Padding="10,9" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="40" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,1,0,0" Click="Check_Click" />
                                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasWarning, Converter={StaticResource Vis}}">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Foreground="{DynamicResource WarningBrush}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding Warning}" Style="{StaticResource Label}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Top" Margin="0,1,12,0"
                                                            Visibility="{Binding Blocked, Converter={StaticResource Vis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="11" Margin="0,0,5,0" />
                                                            <TextBlock Text="Yönetici" FontSize="11.5" />
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Grid.Column="3" Text="{Binding FilesText}" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                    <TextBlock Grid.Column="4" Text="{Binding SizeText}" Style="{StaticResource Num}" HorizontalAlignment="Right" VerticalAlignment="Top" FontWeight="SemiBold" />
                                                    <Button Grid.Column="5" Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Konumu aç" VerticalAlignment="Top" Margin="0,-6,0,0"
                                                            HorizontalAlignment="Right" Click="Reveal_Click" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource Surface2Bg}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                    <Setter TargetName="row" Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Windows araçları -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Windows'un kendi temizlik araçları" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Bu işlemleri Windows yapar; en güvenli yol budur. Gerekirse yönetici izni sorulur." Style="{StaticResource PageSubtitle}" />
                    <ItemsControl x:Name="Tools" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,8">
                                    <Button DockPanel.Dock="Right" Content="{Binding ButtonText}" Tag="{Binding}" Click="Tool_Click" VerticalAlignment="Center" MinWidth="120" />
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
