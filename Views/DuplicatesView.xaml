<UserControl x:Class="TemizlikPaneli.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,26,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Yinelenen dosyalar" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="İçeriği birebir aynı olan dosyaların kopyalarını bulur (yalnızca ad değil, içerik karşılaştırılır). Silmede her gruptan en az bir dosya her zaman korunur." />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="RootCombo" Width="260" DisplayMemberPath="Label" />
                <Button Margin="8,0,0,0" Click="Browse_Click" Content="Klasör seç" />
                <TextBlock Text="En az" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="16,0,8,0" />
                <ComboBox x:Name="MinCombo" Width="100">
                    <ComboBoxItem Content="1 MB" Tag="1" IsSelected="True" />
                    <ComboBoxItem Content="10 MB" Tag="10" />
                    <ComboBoxItem Content="100 MB" Tag="100" />
                </ComboBox>
                <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Scan_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="0,0,8,0" />
                        <TextBlock Text="Ara" />
                    </StackPanel>
                </Button>
                <Button x:Name="StopButton" Margin="8,0,0,0" Content="Durdur" Click="Stop_Click" Visibility="Collapsed" />
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="0,14,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Her gruptan en eskisini koru" Click="KeepOldest_Click" x:Name="KeepOldestButton" />
                <Button Content="En yenisini koru" Margin="8,0,0,0" Click="KeepNewest_Click" x:Name="KeepNewestButton" />
                <Button Content="Seçimi temizle" Margin="8,0,0,0" Click="Clear_Click" x:Name="ClearButton" />
            </StackPanel>
            <TextBlock x:Name="ResultText" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
        </DockPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <ListBox x:Name="List" Style="{StaticResource PlainList}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Padding="8,10,8,6" Margin="0,0,0,6" CornerRadius="8" Background="{DynamicResource Surface2Bg}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <DockPanel Margin="6,0,6,6">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Files}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="Check_Click" />
                                                <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Path}" />
                                                <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource Num}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}" />
                                                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE838;" Width="28" Height="26" ToolTip="Dosya Gezgini'nde göster"
                                                        HorizontalAlignment="Right" Click="Reveal_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="ProgressPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Width="440" Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Height="4" />
                    <TextBlock x:Name="ProgressText" Style="{StaticResource Label}" Margin="0,8,0,0" TextAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" MaxWidth="420"
                           Text="Bir klasör seçip Ara'ya basın. Varsayılan olarak kullanıcı klasörünüz (AppData hariç) taranır." />
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button x:Name="DeleteButton" DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Click="Delete_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,8,0" />
                    <TextBlock Text="Seçilenleri Geri Dönüşüm Kutusu'na taşı" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
        </DockPanel>
    </Grid>
</UserControl>
