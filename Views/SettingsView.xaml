<UserControl x:Class="TemizlikPaneli.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,32" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Ayarlar" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Görünüm, silme yöntemi ve hiçbir zaman dokunulmayacak klasörler." Style="{StaticResource PageSubtitle}" />

            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Görünüm" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton x:Name="ThemeSystem" Style="{StaticResource ChipToggle}" Content="Sistem ayarı" GroupName="theme" Checked="Theme_Checked" />
                        <RadioButton x:Name="ThemeLight" Style="{StaticResource ChipToggle}" Content="Açık" GroupName="theme" Checked="Theme_Checked" />
                        <RadioButton x:Name="ThemeDark" Style="{StaticResource ChipToggle}" Content="Koyu" GroupName="theme" Checked="Theme_Checked" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Dosya ve klasör silme yöntemi" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Disk analizi, kalıntılar, büyük dosyalar ve küçük oyun klasörleri için geçerlidir. Önbellek ve geçici dosyalar her zaman kalıcı silinir; Geri Dönüşüm Kutusu'na gitmeleri yer açmaz."
                               Style="{StaticResource PageSubtitle}" />
                    <RadioButton x:Name="ModeRecycle" GroupName="mode" Margin="0,12,0,0" Checked="Mode_Checked" Style="{StaticResource ChipToggle}" HorizontalAlignment="Left"
                                 Content="Geri Dönüşüm Kutusu'na taşı (önerilen, geri alınabilir)" />
                    <RadioButton x:Name="ModePermanent" GroupName="mode" Margin="0,8,0,0" Checked="Mode_Checked" Style="{StaticResource ChipToggle}" HorizontalAlignment="Left"
                                 Content="Kalıcı olarak sil (yer hemen açılır, geri alınamaz)" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <DockPanel>
                    <ComboBox x:Name="AgeCombo" DockPanel.Dock="Right" Width="200" VerticalAlignment="Center" SelectionChanged="Age_Changed">
                        <ComboBoxItem Content="Hepsini sil" Tag="0" />
                        <ComboBoxItem Content="1 günden eski" Tag="1" />
                        <ComboBoxItem Content="3 günden eski" Tag="3" />
                        <ComboBoxItem Content="7 günden eski" Tag="7" />
                    </ComboBox>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Geçici dosyalar" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Çalışan programların yeni oluşturduğu geçici dosyalara dokunmamak için yaş sınırı. Varsayılan 1 gündür."
                                   Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Click="AddExclusion_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                                <TextBlock Text="Klasör ekle" />
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Hariç tutulan klasörler" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Bu klasörler ve içindekiler hiçbir temizlik ya da silme işleminde değiştirilmez." Style="{StaticResource PageSubtitle}" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl x:Name="ExclusionList" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Listeden çıkar" Tag="{Binding}" Click="RemoveExclusion_Click" />
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoExclusions" Text="Liste boş." Style="{StaticResource Label}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Hakkında" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="AboutText" Style="{StaticResource PageSubtitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Uygulama verisi klasörünü aç" Click="OpenData_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
