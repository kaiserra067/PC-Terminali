<UserControl x:Class="TemizlikPaneli.Views.LeftoversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:TemizlikPaneli.Views">
    <Grid Margin="32,26,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" x:Name="ScanButton" Click="Scan_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0" />
                    <TextBlock Text="Yeniden tara" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Kalıntılar" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Kaldırılmış programlardan geride kalan klasörler, Store uygulaması verileri, sahipsiz oyun klasörleri, bozuk kısayollar ve kaldırıcısı silinmiş kayıtlar. Kurulu olan hiçbir programa, oyuna, hizmete ya da çalışan sürece ait olan klasörler listelenmez." />
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,18,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource GoodBrush}" />
                <TextBlock Text="Kesin: güvenle silinebilir" Style="{StaticResource Label}" Margin="6,0,14,0" />
                <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" />
                <TextBlock Text="Büyük olasılıkla" Style="{StaticResource Label}" Margin="6,0,14,0" />
                <Ellipse Width="8" Height="8" Fill="{DynamicResource SeriousBrush}" />
                <TextBlock Text="Emin değil: kontrol edin" Style="{StaticResource Label}" Margin="6,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource ChipToggle}" Content="Tümü" Tag="all" IsChecked="True" GroupName="conf" Checked="Filter_Changed" />
                <RadioButton Style="{StaticResource ChipToggle}" Content="Kesin" Tag="High" GroupName="conf" Checked="Filter_Changed" />
                <RadioButton Style="{StaticResource ChipToggle}" Content="Büyük olasılıkla" Tag="Medium" GroupName="conf" Checked="Filter_Changed" />
                <RadioButton Style="{StaticResource ChipToggle}" Content="Emin değil" Tag="Low" GroupName="conf" Checked="Filter_Changed" />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="2" x:Name="ProgressPanel" Margin="0,12,0,0" Visibility="Collapsed">
            <ProgressBar IsIndeterminate="True" Height="4" />
            <TextBlock x:Name="ProgressText" Style="{StaticResource Label}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8" Margin="0,12,0,0">
            <Grid>
                <v:LeftoverList x:Name="List" />
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="34" Foreground="{DynamicResource GoodBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" Text="Kalıntı bulunamadı" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="Bilgisayarınızda kaldırılmış programlardan kalan bir şey görünmüyor." Style="{StaticResource Label}" Margin="0,4,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Kesin olanları seç" Click="SelectSure_Click" />
                <Button Content="Seçimi temizle" Margin="8,0,0,0" Click="SelectNone_Click" />
                <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Padding="18,7" Click="Delete_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,8,0" />
                        <TextBlock Text="Seçilenleri sil" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,16,0" />
        </DockPanel>
    </Grid>
</UserControl>
