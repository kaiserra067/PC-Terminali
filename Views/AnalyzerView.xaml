<UserControl x:Class="TemizlikPaneli.Views.AnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TemizlikPaneli.Controls">
    <Grid Margin="32,26,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Disk analizi" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Hangi klasörün ve dosyanın ne kadar yer kapladığını keşfedin. Bir klasöre çift tıklayarak ya da haritada tıklayarak içine girin."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Araç çubuğu -->
        <DockPanel Grid.Row="1" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="RootCombo" Width="260" DisplayMemberPath="Label" />
                <Button Margin="8,0,0,0" Click="Browse_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,8,0" />
                        <TextBlock Text="Klasör seç" />
                    </StackPanel>
                </Button>
                <Button x:Name="ScanButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="Scan_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0" />
                        <TextBlock x:Name="ScanButtonText" Text="Tara" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton" Margin="8,0,0,0" Content="Durdur" Click="Cancel_Click" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource Label}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="16,0,0,0" />
        </DockPanel>

        <!-- İlerleme -->
        <StackPanel Grid.Row="2" x:Name="ProgressPanel" Margin="0,14,0,0" Visibility="Collapsed">
            <ProgressBar IsIndeterminate="True" Height="4" />
            <TextBlock x:Name="ProgressText" Style="{StaticResource Label}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Konum çubuğu -->
        <DockPanel Grid.Row="3" Margin="0,16,0,10">
            <Button x:Name="UpButton" Style="{StaticResource IconButton}" Content="&#xE74A;" ToolTip="Üst klasör" Click="Up_Click" />
            <TextBlock x:Name="FolderSummary" DockPanel.Dock="Right" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <ItemsControl x:Name="Crumbs" VerticalAlignment="Center" Margin="6,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Padding="6,4" Content="{Binding Label}" Tag="{Binding Node}" Click="Crumb_Click" FontWeight="SemiBold" />
                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"
                                       Visibility="{Binding HasNext, Converter={StaticResource Vis}}" Margin="2,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- İçerik -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" MinWidth="480" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="8,8,8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Sütun başlıkları (tıklayınca sıralar) -->
                    <Grid Margin="12,4,22,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="86" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="4,2" HorizontalAlignment="Left" Tag="name" Click="Sort_Click" Content="Ad" FontSize="12" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="4,2" HorizontalAlignment="Right" Tag="size" Click="Sort_Click" Content="Boyut" FontSize="12" />
                        <TextBlock Grid.Column="3" Text="Oran" Style="{StaticResource Label}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <Button Grid.Column="4" Style="{StaticResource GhostButton}" Padding="4,2" HorizontalAlignment="Right" Tag="files" Click="Sort_Click" Content="Dosya" FontSize="12" />
                        <Button Grid.Column="5" Style="{StaticResource GhostButton}" Padding="4,2" HorizontalAlignment="Right" Tag="date" Click="Sort_Click" Content="Değişiklik" FontSize="12" />
                    </Grid>
                    <ListBox x:Name="List" Grid.Row="1" Style="{StaticResource PlainList}" SelectionMode="Extended"
                             MouseDoubleClick="List_DoubleClick" KeyDown="List_KeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Aç" Tag="&#xE8E5;" Click="Open_Click" />
                                <MenuItem Header="Dosya Gezgini'nde göster" Tag="&#xE838;" Click="Reveal_Click" />
                                <MenuItem Header="Yolu kopyala" Tag="&#xE8C8;" Click="CopyPath_Click" />
                                <Separator />
                                <MenuItem Header="Geri Dönüşüm Kutusu'na taşı" Tag="&#xE74D;" Click="Recycle_Click" />
                                <MenuItem Header="Kalıcı olarak sil" Tag="&#xE711;" Click="DeletePermanent_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding FullPath}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="118" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="86" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16" Foreground="{Binding GlyphBrush}" />
                                    <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="8,0,0,0" Visibility="{Binding Note, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Num}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    <Grid Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Height="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource Star}}" />
                                                <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource InvStar}}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{Binding BarBrush}" CornerRadius="0,3,3,0" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding PercentText}" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Grid.Column="4" Text="{Binding FilesText}" Style="{StaticResource Num}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Grid.Column="5" Text="{Binding DateText}" Style="{StaticResource Num}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" MaxWidth="360"
                               Text="Bir sürücü ya da klasör seçip Tara'ya basın." />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="220" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Series1}" />
                            <TextBlock Text="Klasör" Style="{StaticResource Label}" Margin="6,0,12,0" />
                            <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Series2}" />
                            <TextBlock Text="Dosya" Style="{StaticResource Label}" Margin="6,0,12,0" />
                            <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource NeutralMark}" />
                            <TextBlock Text="Küçük öğeler" Style="{StaticResource Label}" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="Yer kaplama haritası" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <c:Treemap x:Name="Map" Grid.Row="1" />
                    <TextBlock Grid.Row="2" Text="Bu klasördeki dosya türleri" Style="{StaticResource SectionTitle}" Margin="0,16,0,10" />
                    <ItemsControl Grid.Row="3" x:Name="KindBars" ItemTemplate="{StaticResource BarRowTemplate}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
