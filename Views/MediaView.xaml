<UserControl x:Class="TemizlikPaneli.Views.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,32">
            <TextBlock Text="Medya indirici" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="YouTube, YouTube Music, X (Twitter), TikTok ve Instagram bağlantılarından video ve ses indirin; videolarınızı GIF'e ya da sese dönüştürün." />

            <!-- Araç durumu -->
            <Border Margin="0,16,0,0" Padding="16,10" CornerRadius="8" Background="{DynamicResource Surface2Bg}">
                <DockPanel>
                    <Button x:Name="ToolsButton" DockPanel.Dock="Right" Content="Araçları güncelle" Click="Tools_Click" VerticalAlignment="Center" />
                    <TextBlock x:Name="ToolsIcon" Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0" />
                    <TextBlock x:Name="ToolsText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0" />
                </DockPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Bağlantıdan indir -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Bağlantıdan indir" Style="{StaticResource SectionTitle}" />
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="Paste_Click" ToolTip="Panodaki bağlantıyı yapıştır">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" Margin="0,0,8,0" />
                                    <TextBlock Text="Yapıştır" />
                                </StackPanel>
                            </Button>
                            <TextBox x:Name="UrlBox" Tag="https://… bağlantısını buraya yapıştırın" TextChanged="Url_Changed" KeyDown="Url_KeyDown" />
                        </DockPanel>
                        <DockPanel Margin="2,8,0,0">
                            <TextBlock x:Name="PlatformIcon" Style="{StaticResource Icon}" FontSize="12" Text="&#xE71B;" Foreground="{DynamicResource TextMuted}" Margin="0,0,6,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="PlatformText" Style="{StaticResource Label}" Text="Desteklenenler: YouTube, YouTube Music, X (Twitter), TikTok, Instagram (Reels, hikaye, gönderi)" TextWrapping="Wrap" />
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <RadioButton x:Name="ModeVideo" Style="{StaticResource ChipToggle}" GroupName="mode" IsChecked="True" Checked="Mode_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE714;" Margin="0,0,6,0" />
                                    <TextBlock Text="Video" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeAudio" Style="{StaticResource ChipToggle}" GroupName="mode" Checked="Mode_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE8D6;" Margin="0,0,6,0" />
                                    <TextBlock Text="Yalnızca ses" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Biçim" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                <ComboBox x:Name="FormatCombo" DisplayMemberPath="Label" SelectionChanged="Format_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" x:Name="QualityPanel">
                                <TextBlock x:Name="QualityLabel" Text="Kalite" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                <ComboBox x:Name="QualityCombo" DisplayMemberPath="Label" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="FormatHint" Style="{StaticResource Label}" Margin="0,8,0,0" TextWrapping="Wrap" />

                        <WrapPanel Margin="0,12,0,0">
                            <CheckBox x:Name="PlaylistCheck" Content="Oynatma listesinin / albümün tamamı" Margin="0,0,18,8" />
                            <CheckBox x:Name="MetaCheck" Content="Kapak ve etiketleri ekle" IsChecked="True" Margin="0,0,18,8" />
                            <CheckBox x:Name="H264Check" Content="En uyumlu video (H.264)" Margin="0,0,18,8"
                                      ToolTip="Eski oynatıcılarda, telefonlarda ve video düzenleyicilerde sorunsuz açılır. YouTube'da en fazla 1080p sunulur." />
                        </WrapPanel>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Oturum (gizli içerik ve hikayeler için)" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                <ComboBox x:Name="CookieCombo" DisplayMemberPath="Label" SelectionChanged="Cookie_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Kayıt klasörü" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Klasörü aç" Click="OpenOutput_Click" Height="34" />
                                    <Button Click="ChooseOutput_Click" HorizontalContentAlignment="Left" Height="34" Padding="10,0">
                                        <TextBlock x:Name="OutputText" TextTrimming="CharacterEllipsis" FontWeight="Normal" />
                                    </Button>
                                </DockPanel>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="DownloadButton" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Padding="20,10" HorizontalAlignment="Left" Click="Download_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,8,0" />
                                <TextBlock Text="İndir" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Dönüştür -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Dönüştür" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <RadioButton x:Name="ConvGif" Style="{StaticResource ChipToggle}" GroupName="conv" IsChecked="True" Content="Videodan GIF" Checked="Conv_Changed" />
                            <RadioButton x:Name="ConvAudio" Style="{StaticResource ChipToggle}" GroupName="conv" Content="Videodan sese" Checked="Conv_Changed" />
                        </StackPanel>

                        <DockPanel Margin="0,14,0,0">
                            <Button DockPanel.Dock="Left" Click="PickFiles_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" Margin="0,0,8,0" />
                                    <TextBlock Text="Video seç" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="FilesText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis" Text="Dosya seçilmedi" />
                        </DockPanel>

                        <!-- GIF ayarları -->
                        <Grid x:Name="GifPanel" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Kare hızı" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                <ComboBox x:Name="FpsCombo">
                                    <ComboBoxItem Content="10 fps (küçük dosya)" Tag="10" />
                                    <ComboBoxItem Content="15 fps" Tag="15" IsSelected="True" />
                                    <ComboBoxItem Content="20 fps" Tag="20" />
                                    <ComboBoxItem Content="25 fps (akıcı)" Tag="25" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Genişlik" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                <ComboBox x:Name="WidthCombo">
                                    <ComboBoxItem Content="320 px" Tag="320" />
                                    <ComboBoxItem Content="480 px" Tag="480" IsSelected="True" />
                                    <ComboBoxItem Content="640 px" Tag="640" />
                                    <ComboBoxItem Content="800 px" Tag="800" />
                                    <ComboBoxItem Content="Orijinal boyut" Tag="0" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                <TextBlock Text="Başlangıç (saniye, isteğe bağlı)" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                <TextBox x:Name="StartBox" Tag="0" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                <TextBlock Text="Süre (saniye, isteğe bağlı)" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                <TextBox x:Name="LengthBox" Tag="tamamı" />
                            </StackPanel>
                        </Grid>

                        <!-- Ses ayarları -->
                        <Grid x:Name="AudioPanel" Margin="0,14,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Ses biçimi" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                <ComboBox x:Name="ConvFormatCombo" SelectionChanged="ConvFormat_Changed">
                                    <ComboBoxItem Content="MP3" Tag="mp3" IsSelected="True" />
                                    <ComboBoxItem Content="M4A (AAC)" Tag="m4a" />
                                    <ComboBoxItem Content="AAC" Tag="aac" />
                                    <ComboBoxItem Content="OGG (Vorbis)" Tag="ogg" />
                                    <ComboBoxItem Content="OPUS" Tag="opus" />
                                    <ComboBoxItem Content="FLAC (kayıpsız)" Tag="flac" />
                                    <ComboBoxItem Content="WAV (sıkıştırmasız)" Tag="wav" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" x:Name="ConvBitratePanel">
                                <TextBlock Text="Ses kalitesi" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                <ComboBox x:Name="ConvBitrateCombo">
                                    <ComboBoxItem Content="320 kbps (en iyi)" Tag="320" IsSelected="True" />
                                    <ComboBoxItem Content="256 kbps" Tag="256" />
                                    <ComboBoxItem Content="192 kbps" Tag="192" />
                                    <ComboBoxItem Content="128 kbps" Tag="128" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Dönüştürülen dosyalar kayıt klasörüne kaydedilir; orijinal dosyaya dokunulmaz." Style="{StaticResource Label}" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <Button x:Name="ConvertButton" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Padding="20,10" HorizontalAlignment="Left" Click="Convert_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" Margin="0,0,8,0" />
                                <TextBlock Text="Dönüştür" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- İşler -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Bitenleri temizle" Click="ClearFinished_Click" />
                        <TextBlock Text="İşler" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="NoJobs" Text="Henüz bir indirme ya da dönüştürme yok." Style="{StaticResource Label}" Margin="0,10,0,4" />
                    <ItemsControl x:Name="Jobs" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="8" Background="{DynamicResource Surface2Bg}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Label}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Height="6" Margin="0,8,0,0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"
                                                         Visibility="{Binding IsActive, Converter={StaticResource Vis}}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding StateGlyph}" Style="{StaticResource Icon}" FontSize="12" Foreground="{Binding StateBrush}" Margin="0,0,6,0"
                                                           Visibility="{Binding IsFinished, Converter={StaticResource Vis}}" />
                                                <TextBlock Text="{Binding Status}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Aç" Padding="12,5" FontSize="12.5" Click="OpenFile_Click" Visibility="{Binding HasFile, Converter={StaticResource Vis}}" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Klasörde göster" Margin="4,0,0,0" Click="RevealJob_Click"
                                                    Visibility="{Binding HasFile, Converter={StaticResource Vis}}" />
                                            <Button Content="İptal" Padding="12,5" FontSize="12.5" Click="CancelJob_Click" Visibility="{Binding IsActive, Converter={StaticResource Vis}}" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE8A5;" ToolTip="Ayrıntılı günlük" Margin="4,0,0,0" Click="LogJob_Click"
                                                    Visibility="{Binding IsFinished, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Label}" Margin="2,14,0,0" TextWrapping="Wrap"
                       Text="Yalnızca hakkına sahip olduğunuz ya da kişisel kullanım için indirilmesine izin verilen içerikleri indirin. Platform kurallarına ve telif haklarına uymak kullanıcının sorumluluğundadır." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
